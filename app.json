{
  "expo": {
    "name": "Морс",
    "slug": "berryrise",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/fda86666-4947-4c12-b225-632bae741322",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.berryrise.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.berryrise.app"
    },
    "scheme": "berryrise",
    "plugins": [
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#F4F1EA",
          "dark": {
            "backgroundColor": "#1A1917"
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "Streak",
              "label": "Счетчик дней",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "previewImage": "./assets/widget-preview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StreakInk",
              "label": "Счетчик дней, темный",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "previewImage": "./assets/widget-preview-ink.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "owner": "flucky",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fda86666-4947-4c12-b225-632bae741322"
      }
    }
  }
}
