{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // TODO(release): временно только arm64, чтобы сборка шла быстрее. Для релиза убрать reactNativeArchitectures:
      // нужны все архитектуры (armeabi-v7a для старых телефонов, x86/x86_64 для эмуляторов).
      // NODE_ENV: без него @expo/env пишет в лог, что не знает режим для .env (а .env у нас нет)
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "NODE_ENV": "development",
        // отдельный пакет com.berryrise.app.dev, см. app.config.ts
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // TODO(release): см. development, для релиза убрать
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" },
      "channel": "preview"
    },
    // Сборка для Google Play. TODO(release): архитектуры как у preview; политика приватности
    // для Play должна упоминать проверку обновлений при запуске (единственный сетевой запрос)
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" },
      "channel": "production"
    }
  }
}
