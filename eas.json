{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // Только arm64, чтобы сборка шла быстрее: dev и preview ставим только на свои телефоны.
      // Все архитектуры собирает только production.
      // NODE_ENV: без него @expo/env пишет в лог, что не знает режим для .env (а .env у нас нет)
      "env": {
        "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a",
        "NODE_ENV": "development",
        // отдельный пакет com.berryrise.app.dev, см. app.config.ts
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // только arm64, см. development
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" },
      "channel": "preview"
    },
    // Сборка для Google Play. Все архитектуры по умолчанию (armeabi-v7a - старые и бюджетные
    // телефоны с 32-битной системой, x86_64 - хромбуки): Play сам режет AAB по ABI, пользователю
    // приходит только его вариант. TODO(release): политика приватности для Play должна упоминать
    // проверку обновлений при запуске (единственный сетевой запрос)
    "production": {
      "android": { "buildType": "app-bundle" },
      "channel": "production"
    }
  }
}
