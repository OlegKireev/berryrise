{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // TODO(release): временно только arm64, чтобы сборка шла быстрее. Для релиза убрать env:
      // нужны все архитектуры (armeabi-v7a для старых телефонов, x86/x86_64 для эмуляторов)
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      // TODO(release): см. development, для релиза убрать
      "env": { "ORG_GRADLE_PROJECT_reactNativeArchitectures": "arm64-v8a" }
    }
  }
}
