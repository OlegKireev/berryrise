{
  "name": "resheno",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.28",
    "expo-constants": "~57.0.21",
    "expo-contacts": "~57.0.7",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-haptics": "~57.0.3",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:eas:dev": "yarn dlx eas-cli build --profile development --platform android",
    "build:eas:preview": "yarn dlx eas-cli build --profile preview --platform android",
    "build:local:dev": "yarn dlx eas-cli build --local --profile development --platform android --output dist/resheno-dev.apk",
    "build:local:preview": "yarn dlx eas-cli build --local --profile preview --platform android --output dist/resheno-preview.apk",
    "install:dev": "adb install -r dist/resheno-dev.apk",
    "install:preview": "adb install -r dist/resheno-preview.apk",
    "eas": "yarn dlx eas-cli",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "audit": "yarn npm audit --all --recursive --no-deprecations",
    "test": "TZ=Europe/Berlin node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "lint:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json --warning src/",
    "lint:unused": "knip"
  },
  "private": true,
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml}": "prettier --write"
  },
  "resolutions": {
    "xcode/uuid": "^11.1.1"
  }
}
