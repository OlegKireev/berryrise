{
  "name": "resheno",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "expo-doctor": "1.20.4",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "audit": "yarn npm audit --all --recursive --no-deprecations",
    "test": "TZ=Europe/Berlin node --test 'src/**/*.test.ts'",
    "format": "prettier --write .",
    "lint:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json --warning src/",
    "lint:unused": "knip"
  },
  "private": true,
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml}": "prettier --write"
  },
  "resolutions": {
    "xcode/uuid": "^11.1.1"
  }
}
